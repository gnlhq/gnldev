{
  "name": "@gnldev/server",
  "version": "0.14.0",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "description": "Auto-REST + OpenAPI for @gnldev/durable agents: createGnl registry → HTTP router (run/resume/runs + openapi.json).",
  "keywords": [
    "ai",
    "agent",
    "llm",
    "typescript",
    "ai-sdk",
    "durable",
    "exactly-once",
    "rest",
    "hono",
    "openapi",
    "fetch-handler"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "default": "./dist/node.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@gnldev/a2a": "workspace:^",
    "@gnldev/auth": "workspace:^",
    "@gnldev/options": "workspace:^",
    "@gnldev/workflow": "workspace:^",
    "@hono/node-server": "^1.19.17",
    "hono": "^4.13.2"
  },
  "peerDependencies": {
    "@gnldev/durable": "workspace:^"
  },
  "devDependencies": {
    "@fastify/middie": "^9.3.6",
    "@gnldev/durable": "workspace:*",
    "@types/express": "^5.0.6",
    "@types/koa": "^3.0.3",
    "@types/koa-bodyparser": "^4.3.13",
    "ai": "^7.0.0",
    "express": "^5.2.1",
    "fastify": "^5.12.7",
    "koa": "^3.2.1",
    "koa-bodyparser": "^4.4.1",
    "koa-connect": "^2.1.1",
    "zod": "^3.25.0"
  },
  "author": "Karaca Yılmaz (https://gnl.dev)",
  "homepage": "https://gnl.dev",
  "bugs": {
    "url": "https://github.com/gnlhq/gnldev/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gnlhq/gnldev.git",
    "directory": "packages/server"
  },
  "publishConfig": {
    "access": "public"
  }
}
