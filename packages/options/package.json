{
  "name": "@gnldev/options",
  "version": "0.10.0",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "description": "One rule for every GNL options object: a name it does not take is refused, with the option it is closest to. No dependencies.",
  "keywords": [
    "gnl",
    "options",
    "validation",
    "typescript"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "author": "Karaca Y\u0131lmaz (https://gnl.dev)",
  "homepage": "https://gnl.dev",
  "bugs": {
    "url": "https://github.com/gnlhq/gnldev/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gnlhq/gnldev.git",
    "directory": "packages/options"
  },
  "publishConfig": {
    "access": "public"
  }
}
