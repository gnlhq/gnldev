{
  "name": "@gnldev/a2a",
  "version": "0.13.0",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "description": "Agent2Agent (A2A) for GNL: serve your agents to any A2A client (agent card + JSON-RPC message/send, tasks/get, tasks/cancel) and call remote agents \u2014 GNL or standard A2A \u2014 as an AI SDK tool. Deterministic task ids: a retried call is answered once by a GNL server (a remote that does not dedupe on messageId may run it again).",
  "keywords": [
    "ai",
    "agent",
    "llm",
    "typescript",
    "ai-sdk",
    "durable",
    "exactly-once",
    "remote-agents",
    "a2a",
    "agent2agent",
    "json-rpc"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@gnldev/auth": "workspace:^",
    "@gnldev/options": "workspace:^"
  },
  "peerDependencies": {
    "@gnldev/durable": "workspace:^",
    "ai": "^7.0.0",
    "zod": "^3.25.76 || ^4.1.8"
  },
  "peerDependenciesMeta": {
    "@gnldev/durable": {
      "optional": true
    }
  },
  "devDependencies": {
    "@gnldev/durable": "workspace:*",
    "ai": "^7.0.0",
    "zod": "^3.25.0"
  },
  "author": "Karaca Y\u0131lmaz (https://gnl.dev)",
  "homepage": "https://gnl.dev",
  "bugs": {
    "url": "https://github.com/gnlhq/gnldev/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gnlhq/gnldev.git",
    "directory": "packages/a2a"
  },
  "publishConfig": {
    "access": "public"
  }
}
