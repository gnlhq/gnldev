{
  "name": "@gnldev/lab",
  "version": "0.15.1",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "description": "Why an agent did what it did, and what it would do changed — measured by playing its runs again with parts left out: what brought a call about, which words decided it, whether a prompt section can go, and the cheapest form of a new agent that does the work.",
  "keywords": [
    "ai",
    "agent",
    "llm",
    "typescript",
    "ai-sdk",
    "explainability",
    "shapley",
    "counterfactual",
    "prompt"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@gnldev/durable": "workspace:^",
    "ai": "^7.0.0"
  },
  "devDependencies": {
    "@gnldev/durable": "workspace:*",
    "ai": "^7.0.0",
    "zod": "^3.25.0"
  },
  "author": "Karaca Y\u0131lmaz (https://gnl.dev)",
  "homepage": "https://gnl.dev",
  "bugs": {
    "url": "https://github.com/gnlhq/gnldev/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gnlhq/gnldev.git",
    "directory": "packages/lab"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@gnldev/experiment": "workspace:^",
    "@gnldev/options": "workspace:^"
  }
}
