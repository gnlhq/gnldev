{
  "name": "gnldev",
  "private": true,
  "description": "gnl — a durable execution substrate for AI agents (monorepo)",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "build": "pnpm -r build",
    "pretest": "node scripts/check-dist-fresh.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:legacy": "pnpm --filter @gnldev/upgrade-tests test",
    "typecheck": "pnpm -r typecheck",
    "check:docs": "node scripts/check-doc-samples.mjs",
    "check:versions": "node scripts/check-versions.mjs",
    "check:errors": "node scripts/check-error-pages.mjs",
    "check:real": "node scripts/check-real-backends.mjs",
    "check:hygiene": "node scripts/check-hygiene.mjs",
    "check:option-docs": "node scripts/check-option-docs.mjs",
    "check:option-names": "node scripts/check-option-names.mjs",
    "lint": "oxlint --type-aware packages/ test/",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "version": "changeset version",
    "version:snapshot": "changeset version --snapshot canary",
    "version:pre:alpha": "changeset pre enter alpha",
    "version:pre:beta": "changeset pre enter beta",
    "version:pre:exit": "changeset pre exit"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^2.1.9",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.9.1",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.9.1"
}
